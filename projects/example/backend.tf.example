# Copy to backend.tf, keep ONE block, then run: terraform init -migrate-state
# One state per dbt project: give every project directory its own key/name.
# See docs/state.md.

# --- Option A: GitLab-managed Terraform state --------------------------------
# Address, lock/unlock addresses and credentials are passed at init time
# (see docs/state.md), so nothing environment-specific is committed.
terraform {
  backend "http" {}
}

